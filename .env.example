# Optional. You can enter every credential on the Connections page instead.
# If you use this file: copy it to .env and never commit .env.
ANTHROPIC_API_KEY=
# Deploying (all three are required off localhost; the app refuses to start without APP_PASSWORD)
# HOST=0.0.0.0
# APP_PASSWORD=choose-a-long-secret      (browser login: any user name, this password)
# PUBLIC_URL=https://seo.example.com     (also used for the Google OAuth redirect URI)
# ALLOWED_HOSTS=other.example.com,another.example.com
# DATA_DIR=/data                         (put this on a persistent disk; it holds nineteen.db with saved keys)
# Optional settings
# MODEL=claude-opus-5-5
# EFFORT=medium
# PORT=3019

# Google (Search Console + Analytics 4). Create an OAuth client of type "Web application" in Google Cloud,
# enable the Search Console API, Analytics Data API and Analytics Admin API, and add this redirect URI:
#   http://localhost:3019/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DataForSEO API credentials (from your DataForSEO dashboard, API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Other AI models (optional; easier to enter on the Connections page)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Google results providers (optional)
# SERPAPI_API_KEY=
# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_SERP_ZONE=
# BRIGHTDATA_UNLOCKER_ZONE=

# Point the ChatGPT (OpenAI) provider at any OpenAI-compatible server instead (Azure, a local model, a proxy)
# OPENAI_BASE_URL=
